rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      // For now, any authenticated user is considered an admin since this is an admin-only system
      // In a real app, you would check a custom claim or a users collection
      return isAuthenticated();
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidSermon(data) {
      return hasOnlyAllowedFields(['title', 'topic', 'goal', 'manuscript', 'inputMode', 'status', 'createdAt', 'updatedAt', 'blog', 'youtubeScript', 'socialPosts', 'email', 'excerpt', 'seoTitle', 'metaDescription', 'focusKeyword', 'slug', 'featuredImage', 'publishAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.topic is string && data.topic.size() > 0 && data.topic.size() < 200 &&
             data.goal is string && data.goal.size() > 0 && data.goal.size() < 1000 &&
             data.manuscript is string && data.manuscript.size() >= 0 && data.manuscript.size() < 100000 &&
             data.inputMode in ['topic_goal', 'manuscript'] &&
             data.status in ['draft', 'published', 'processed', 'scheduled'] &&
             data.createdAt is timestamp &&
             (!('updatedAt' in data) || data.updatedAt is timestamp) &&
             (!('blog' in data) || (data.blog is string && data.blog.size() < 100000)) &&
             (!('youtubeScript' in data) || (data.youtubeScript is string && data.youtubeScript.size() < 100000)) &&
             (!('socialPosts' in data) || (data.socialPosts is list && data.socialPosts.size() <= 10)) &&
             (!('email' in data) || (data.email is string && data.email.size() < 50000)) &&
             (!('excerpt' in data) || (data.excerpt is string && data.excerpt.size() < 5000)) &&
             (!('seoTitle' in data) || (data.seoTitle is string && data.seoTitle.size() < 200)) &&
             (!('metaDescription' in data) || (data.metaDescription is string && data.metaDescription.size() < 500)) &&
             (!('focusKeyword' in data) || (data.focusKeyword is string && data.focusKeyword.size() < 100)) &&
             (!('slug' in data) || (data.slug is string && data.slug.size() < 200)) &&
             (!('featuredImage' in data) || (data.featuredImage is string && data.featuredImage.size() < 2000)) &&
             (!('publishAt' in data) || (data.publishAt is string && data.publishAt.size() < 100));
    }

    function isValidGalleryImage(data) {
      return hasOnlyAllowedFields(['state', 'title', 'caption', 'imageUrl', 'storagePath', 'order', 'featured', 'status', 'createdAt', 'updatedAt']) &&
             data.state is string && data.state.size() > 0 && data.state.size() < 100 &&
             data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() < 2000 &&
             data.storagePath is string && data.storagePath.size() > 0 && data.storagePath.size() < 1000 &&
             data.createdAt is timestamp &&
             (!('title' in data) || (data.title is string && data.title.size() < 200)) &&
             (!('caption' in data) || (data.caption is string && data.caption.size() < 1000)) &&
             (!('order' in data) || data.order is number) &&
             (!('featured' in data) || data.featured is bool) &&
             (!('status' in data) || data.status in ['active', 'inactive']) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /sermons/{sermonId} {
      // Allow read for everyone if the sermon is published or scheduled
      // Admins can read everything
      allow read: if isAdmin() || resource.data.status in ['published', 'scheduled'];
      allow create: if isAdmin() && isValidSermon(request.resource.data);
      allow update: if isAdmin() && isValidSermon(request.resource.data);
      allow delete: if isAdmin();
    }

    match /state_galleries/{imageId} {
      allow read: if true; // Publicly readable
      allow create: if isAdmin() && isValidGalleryImage(request.resource.data);
      allow update: if isAdmin() && isValidGalleryImage(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
